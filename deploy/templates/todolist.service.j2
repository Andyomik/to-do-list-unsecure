[Unit]
Description=Todolist Django (Gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User={{ app_user }}
Group={{ app_user }}
WorkingDirectory={{ app_src }}
EnvironmentFile=/etc/todolist.env
ExecStart={{ app_venv }}/bin/gunicorn --workers 2 --bind 0.0.0.0:80 todo.wsgi:application
Restart=on-failure

# Ex 17 (J1) : seule capacite accordee = ecouter sur le port 80
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Ex 15 (J3) : isolation du service, reduire le rayon de l'explosion
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths={{ app_src }}

[Install]
WantedBy=multi-user.target
